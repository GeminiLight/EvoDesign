{
  "name": "evodesign-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "capture-pages": "node scripts/capture-pages.mjs",
    "test:icons": "node --test scripts/test-node-icons.mjs",
    "test:editor": "node --test scripts/test-editor-integrity.mjs",
    "dev:browser": "vite --mode browser --host 127.0.0.1 --port 5176 --strictPort",
    "build:browser": "tsc -b && vite build --mode browser",
    "test:browser": "node --test scripts/test-browser-mode.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@excalidraw/excalidraw": "^0.18.0",
    "@stripe/stripe-js": "^8.7.0",
    "@tldraw/tldraw": "^3.15.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fractional-indexing": "3.2.0",
    "globals": "^16.5.0",
    "playwright": "^1.52.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "nanoid@>=3 <4": "^3.3.20",
    "nanoid@>=4 <5": "^5.1.16",
    "postcss": "$postcss"
