# ============================================================================
# Backend Environment Configuration
# ============================================================================
# Copy this file to `backend/.env` and fill in your values.

# ============================================================================
# Application
# ============================================================================
# APP_NAME=EvoDiagram API
# APP_VERSION=1.0.0
# DEBUG=false
# HOST=0.0.0.0
# PORT=3010

# ============================================================================
# Database
# ============================================================================
# DB_TYPE=sqlite
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=evodiagram
# DB_USER=postgres
# DB_PASSWORD=

# ============================================================================
# Auth / Security  -- REQUIRED
# ============================================================================
JWT_SECRET=                                        # REQUIRED - set before running backend
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_IN=604800
SESSION_SECRET=                                    # REQUIRED - set before running backend

# Guest token (guest mode, skips JWT auth and DB storage).
# The frontend always sends its VITE_GUEST_TOKEN as a bearer token when nobody
# is signed in; the backend accepts it only when GUEST_TOKEN is set AND matches
# exactly. Left unset, every guest generation returns 401. Set it to the same
# value as frontend/.env's VITE_GUEST_TOKEN to turn guest generation on.
# WARNING: this opens an unauthenticated path to the LLM generation endpoints.
# Enable it deliberately and use a non-public value in any shared deployment.
# See the GUEST_TOKEN notes in the repo-root .env.example for full details.
# GUEST_TOKEN=evodiagram-guest-public-token

# ============================================================================
# OAuth - Google
# ============================================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ============================================================================
# OAuth - GitHub
# ============================================================================
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# ============================================================================
# Signup Verification
# ============================================================================
# ENABLE_SIGNUP_VERIFICATION=true
# SIGNUP_VERIFICATION_CODE=123456

# ============================================================================
# Stripe
# ============================================================================
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ============================================================================
# CORS / Frontend
# ============================================================================
# APP_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173

# ============================================================================
# LLM (backend proxies diagram generation requests)
# ============================================================================
# Default local backend setup uses explicit provider settings:
# LLM_MODEL_PROVIDER=openai
# LLM_MODEL_NAME=step-3.7-flash
# LLM_API_KEY=
# LLM_ENDPOINT_URL=https://api.stepfun.com/v1
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=16384
# Optional for reasoning models that support it; omit for other models.
# LLM_REASONING_EFFORT=low

# ============================================================================
# Diagram generation
# ============================================================================
# CANVAS_LIBRARY=excalidraw
# RESULTS_DIR=results
# Automatic quality loop is available to every account tier.
# AUTO_REFINE_ENABLED=true
# AUTO_REFINE_MAX_ITERATIONS=2
# DESIGN_MEMORY_ENABLED=true
# DESIGN_MEMORY_PATH=data/web-design-memory
# DESIGN_MEMORY_SEED_PATH=evo_diagram/design_memory/seeds/web_strategies.json
# DESIGN_MEMORY_MODEL=Qwen/Qwen3-Embedding-0.6B
# DESIGN_MEMORY_TOP_K=2
# DESIGN_MEMORY_LEARNING=true
# Retain intermediate images/reports only for local diagnosis (default false).
# RETAIN_GENERATION_ARTIFACTS=false
