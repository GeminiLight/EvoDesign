# EvoDesign — shared CLI and backend configuration.
# Run python scripts/setup_local.py once; then fill the three LLM values below.
# Use an OpenAI-compatible chat-completions base URL (usually ending in /v1),
# not a /responses or /chat/completions request URL. Vision input is required.
LLM_MODEL_PROVIDER=openai
LLM_MODEL_NAME=
LLM_ENDPOINT_URL=
LLM_API_KEY=
LLM_TEMPERATURE=1
LLM_MAX_TOKENS=16384
# Optional; only enable if your selected model supports it.
# LLM_REASONING_EFFORT=low

# setup_local.py generates unique local secrets and a matching frontend guest token.
JWT_SECRET=
SESSION_SECRET=
GUEST_TOKEN=
# Guests may run this many generations (generate, stream, local edit) per client
# IP per UTC day; 0 disables guest generation. Counts persist in the database.
# GUEST_DAILY_GENERATION_LIMIT=10
# Proxies whose X-Forwarded-For the backend trusts for rate limits and guest
# quotas (comma-separated IPs/CIDRs; uvicorn reads the same variable).
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Wall-clock budget for one logical LLM call including retries and JSON repair
# turns (seconds; 0 disables).
# EVO_LLM_CALL_DEADLINE_SECONDS=1800
# Optional per-generation caps on LLM requests and total wall-clock time
# (unset means no cap).
# EVO_LLM_RUN_MAX_CALLS=
# EVO_LLM_RUN_DEADLINE_SECONDS=
DB_TYPE=sqlite
DB_NAME=evodesign
HOST=127.0.0.1
# Web approval origin for project-scoped Agent connections.
# FRONTEND_URL=http://localhost:5175
# Custom renderer port: the native PNG renderer uses this exact page URL.
# EXCALIDRAW_RENDER_URL=http://localhost:3000/renderers/excalidraw
# Standalone Agent CLI only: export this in your terminal, not in this .env file.
# EVODESIGN_CONFIG_DIR=/absolute/private/path/evodesign
# CANVAS_LIBRARY=excalidraw
AUTO_REFINE_ENABLED=true
DESIGN_MEMORY_ENABLED=true
DESIGN_MEMORY_LEARNING=true
RETAIN_GENERATION_ARTIFACTS=false
# Architecture diagrams: execute the layout agent's tier plan and the style
# agent's palette families as uniform cards with shared-trunk routing.
# Set to 0 to keep the agents' free-form geometry.
# EVODESIGN_ARCH_DESIGN_SYSTEM=1

# Independent evaluation judge (set roles.eval: judge-vlm in configs/settings.yaml).
# JUDGE_MODEL_NAME=
# JUDGE_ENDPOINT_URL=
# JUDGE_API_KEY=
# Optional named model in configs/models.yaml:
# STEPFUN_API_KEY=

# Optional test target for tests/integration/test_renderer_http.py.
# RENDERER_SMOKE_URL=http://127.0.0.1:3000

# Optional shared demo. Set on Vercel or in root .env.local for loopback browser dev.
# Never prefix these server-only secrets with VITE_. Local use has process-local counters.
# Uses BigModel's general API and an independent evodesign Redis budget namespace.
# DEMO_GLM_API_KEY=
# DEMO_REDIS_URL=
# DEMO_REDIS_TOKEN=
# DEMO_DAILY_TOKENS=2000000
# DEMO_CONCURRENCY=4
# DEMO_VISITOR_REQUESTS=40
# Optional: identical server-only secret on the Cloudflare entry and Vercel.
# Signs the ingress client IP; never accept unsigned forwarded IP headers.
# DEMO_EDGE_IP_SECRET=

# ModelScope Node adapter (port 7860); keep the same Redis budget as Vercel.
# STUDIO_PUBLIC_ORIGIN=https://geminilight-evodesign.ms.show
# APP_REVISION=

# Local browser demo options (Redis is only required by the deployed shared demo).
# DEMO_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DEMO_USE_ENV_PROXY=1
