{
  "name": "evo-diagram-tool-services",
  "version": "1.0.0",
  "description": "Tool services for EvoDiagram - layout, text-width measurement, and rendering",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "export": "NEXT_EXPORT=1 next build",
    "lint": "next lint",
    "layout": "npx tsx scripts/layout-cli.ts",
    "text-width": "npx tsx scripts/text-width-cli.ts",
    "render-tldraw": "npx tsx scripts/render-tldraw.ts",
    "render-excalidraw": "npx tsx scripts/render-excalidraw.ts",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit --incremental false"
  },
  "keywords": [
    "diagram",
    "layout",
    "rendering",
    "tldraw",
    "excalidraw"
  ],
  "author": "AuraX AI",
  "license": "MIT",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "canvas": "^3.0.0",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "next": "^15.5.28",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tldraw": "^3.15.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.9",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "commander": "^12.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "playwright": "^1.44.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "nanoid@>=3 <4": "^3.3.20",
    "nanoid@>=4 <5": "^5.1.16",
    "postcss": "^8.5.31"
  }
}
