{
  "name": "@evodesign/render-engine",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript port of evodesign/agentic_system/render_engine (Excalidraw path), verified against Python fixtures.",
  "type": "module",
  "imports": {
    "#platform": {
      "browser": "./src/py/platform_browser.ts",
      "default": "./src/node/platform.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "fixtures": "cd ../.. && PYTHONPATH=. .venv/bin/python packages/render-engine/tools/export_fixtures.py",
    "parity": "vitest run test/parity/functions.test.ts",
    "parity:stages": "tsx tools/parity-stages.ts",
    "render": "tsx tools/render.ts",
    "ledger": "tsx tools/ledger.ts",
    "test": "vitest run",
    "parity:runs": "tsx tools/parity-runs.ts",
    "record:runs": "cd ../.. && PYTHONPATH=. .venv/bin/python packages/render-engine/tools/record_runs.py",
    "parity:web": "tsx tools/parity-web.ts",
    "record:web": "cd ../.. && PYTHONPATH=. .venv/bin/python packages/render-engine/tools/record_web_runs.py",
    "fixtures:phase2": "cd ../.. && PYTHONPATH=. .venv/bin/python packages/render-engine/tools/export_fixtures.py --phase2",
    "check:browser": "tsx tools/check-browser.ts",
    "parity:render": "tsx tools/wp28/compare-renderers.ts",
    "build:browser": "tsx tools/build-browser.ts",
    "test:http": "vitest run test/models/http_parity.test.ts",
    "test:worker": "tsx tools/browser-smoke.ts",
    "test:shared-worker": "tsx tools/browser-smoke.ts --hosted"
  },
  "dependencies": {
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.1",
    "@langchain/openai": "1.6.3",
    "fast-png": "8.0.0",
    "langchain": "1.5.18",
    "pako": "2.1.0",
    "playwright": "1.58.2",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pako": "2.0.3",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "types": "./browser.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
